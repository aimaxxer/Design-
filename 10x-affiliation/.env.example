# Copy to .env.local and fill in.

# Where the 6-question partner qualifier POSTs its JSON (your CRM webhook, Zapier, Make, n8n...).
# Leave empty to simulate submissions (the payload is logged to the browser console).
VITE_QUALIFIER_ENDPOINT=

# Calendly event for the 30-minute partner strategy call, e.g. https://calendly.com/10x-affiliation/strategy-call
# Name, email and region from the qualifier are prefilled. Leave empty to show the placeholder panel.
VITE_CALENDLY_URL=
